<?xml version="1.0"?>
<sdf version="1.10">
  <world name="room">
    <physics name="1ms" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.8 0.85 0.9 1</background></scene>

    <light type="directional" name="sun">
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 8 x 8 m room, walls 0.2 m thick -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="n"><pose>0 4 0.5 0 0 0</pose><geometry><box><size>8.2 0.2 1</size></box></geometry></collision>
        <visual name="n"><pose>0 4 0.5 0 0 0</pose><geometry><box><size>8.2 0.2 1</size></box></geometry><material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>
        <collision name="s"><pose>0 -4 0.5 0 0 0</pose><geometry><box><size>8.2 0.2 1</size></box></geometry></collision>
        <visual name="s"><pose>0 -4 0.5 0 0 0</pose><geometry><box><size>8.2 0.2 1</size></box></geometry><material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>
        <collision name="e"><pose>4 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.2 1</size></box></geometry></collision>
        <visual name="e"><pose>4 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.2 1</size></box></geometry><material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>
        <collision name="w"><pose>-4 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.2 1</size></box></geometry></collision>
        <visual name="w"><pose>-4 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.2 1</size></box></geometry><material><ambient>0.9 0.85 0.7 1</ambient><diffuse>0.9 0.85 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box1">
      <static>true</static>
      <pose>2 1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1 1 1</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="diff_bot">
      <pose>0 0 0.1 0 0 0</pose>
      <link name="base">
        <inertial><mass>5</mass><inertia><ixx>0.05</ixx><iyy>0.08</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.4 0.25 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.25 0.1</size></box></geometry><material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material></visual>
        <collision name="caster"><pose>-0.15 0 -0.05 0 0 0</pose><geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
        <collision name="caster_front"><pose>0.15 0 -0.05 0 0 0</pose><geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
        <sensor name="lidar" type="gpu_lidar">
          <pose>0.1 0 0.2 0 0 0</pose>
          <topic>scan</topic><gz_frame_id>lidar_link</gz_frame_id>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <lidar>
            <scan><horizontal><samples>360</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
            <range><min>0.12</min><max>10</max></range>
          </lidar>
        </sensor>
      </link>
      <link name="left_wheel">
        <pose>0 0.15 0 -1.5708 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      </link>
      <link name="right_wheel">
        <pose>0 -0.15 0 -1.5708 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      </link>
      <joint name="left_joint" type="revolute">
        <parent>base</parent><child>left_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="right_joint" type="revolute">
        <parent>base</parent><child>right_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_joint</left_joint>
        <right_joint>right_joint</right_joint>
        <wheel_separation>0.3</wheel_separation>
        <wheel_radius>0.1</wheel_radius>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base</child_frame_id>
        <odom_publish_frequency>20</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
